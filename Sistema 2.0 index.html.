<script>
/* =========================================================
   D'Ksa — Sistema de pedidos via WhatsApp
   ========================================================= */
(() => {
  'use strict';

  /* ---------- Utilidades ---------- */
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const BRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
  const money = n => BRL.format(n || 0);
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const uid = p => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
  const clone = o => JSON.parse(JSON.stringify(o));
  const parseNum = str => {
    if (str === '' || str == null) return null;
    const n = Number(String(str).replace(/[^\d,.-]/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.'));
    return Number.isFinite(n) ? n : NaN;
  };
  const onlyDigits = s => String(s || '').replace(/\D/g, '');

  /* Armazenamento seguro (funciona mesmo se o localStorage estiver bloqueado) */
  const store = (() => {
    const mem = {};
    let ls = null;
    try { ls = window.localStorage; ls.setItem('__t', '1'); ls.removeItem('__t'); } catch { ls = null; }
    return {
      get(k, fb) { try { const v = ls ? ls.getItem(k) : mem[k]; return v ? JSON.parse(v) : fb; } catch { return fb; } },
      set(k, v) { const s = JSON.stringify(v); try { ls ? ls.setItem(k, s) : (mem[k] = s); } catch { mem[k] = s; } },
      del(k) { try { ls ? ls.removeItem(k) : delete mem[k]; } catch { delete mem[k]; } }
    };
  })();

  const KEY_CART = 'saborDksa.cart.v2', KEY_CUST = 'saborDksa.customer.v2';

  /* ---------- Estado ---------- */
  let menu = clone(window.DEFAULT_MENU);
  let cart = store.get(KEY_CART, []);
  let query = '';
  let step = 1;
  let cepState = { ok: false, cep: '', data: null };

  const saveCart = () => store.set(KEY_CART, cart);

  const findItem = id => {
    for (const c of menu.categories) { const i = c.items.find(x => x.id === id); if (i) return { cat: c, item: i }; }
    return null;
  };

  /* ---------- Toast ---------- */
  let toastT;
  function toast(msg, type = '') {
    const t = $('#toast');
    t.textContent = msg; t.className = 'toast show ' + type;
    clearTimeout(toastT); toastT = setTimeout(() => t.className = 'toast', 2600);
  }

  /* ---------- Modais ---------- */
  let lastFocus;
  function openModal(id) {
    lastFocus = document.activeElement;
    const m = $('#' + id); m.hidden = false;
    const f = m.querySelector('input:not([type=radio]):not([type=checkbox]), select, button.btn--primary');
    setTimeout(() => f && f.focus(), 30);
  }
  function closeModal(id) {
    $('#' + id).hidden = true;
    lastFocus && lastFocus.focus && lastFocus.focus();
    if (id === 'reservaModal') stopReservaBg();
  }
  $$('.modal').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m || e.target.closest('[data-close]')) closeModal(m.id); });
  });
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    const open = $$('.modal').find(m => !m.hidden);
    if (open) return closeModal(open.id);
    if ($('#drawer').classList.contains('is-open')) closeDrawer();
  });


  /* =========================================================
     CARDÁPIO
     ========================================================= */
  function priceLabel(item) {
    const prices = item.variants.map(v => v.price).filter(p => p != null);
    if (!prices.length) return '<span class="price price--ask">Valor a consultar</span>';
    if (item.variants.length === 1) return `<span class="price">${money(prices[0])}</span>`;
    const min = Math.min(...prices), max = Math.max(...prices);
    if (min === max) return `<span class="price">${money(min)}</span>`;
    return `<span class="price"><small>a partir de</small> ${money(min)}</span>`;
  }
  function variantTags(item) {
    if (item.variants.length < 2) return '';
    return `<div>${item.variants.map(v => `<span class="tag">${esc(v.label)}${v.price != null ? ' · ' + money(v.price) : ''}</span>`).join(' ')}</div>`;
  }

  const norm = s => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  function renderMenu() {
    const main = $('#cardapio');
    const q = norm(query.trim());
    let html = '', total = 0;
    menu.categories.forEach(cat => {
      const items = cat.items.filter(i => i.available !== false &&
        (!q || norm(i.name + ' ' + (i.desc || '')).includes(q)));
      if (!items.length) return;
      total += items.length;
      html += `<section class="cat-sec" id="cat-${cat.id}" data-cat="${cat.id}">
        <div class="cat-sec__head">
          <h2 class="cat-sec__title">${esc(cat.name)}</h2>
        </div>
        <div class="grid">
          ${items.map(cardHTML).join('')}
        </div>
      </section>`;
    });
    main.innerHTML = html || `<div class="no-results"><p class="empty__title">Nada encontrado</p><p>Tente outro termo de busca.</p></div>`;
    renderCats();
  }

  function cardHTML(i) {
    const off = i.available === false;
    return `<article class="card ${off ? 'is-off' : ''}">
      <div class="card__top">
        <h3 class="card__name">${esc(i.name)}</h3>
        ${off ? '<span class="tag">Indisponível</span>' : ''}
      </div>
      ${i.desc ? `<p class="card__desc">${esc(i.desc)}</p>` : ''}
      ${variantTags(i)}
      <div class="card__foot">
        ${priceLabel(i)}
        <button class="add-btn" data-add="${i.id}" aria-label="Adicionar ${esc(i.name)}">+</button>
      </div>
    </article>`;
  }

  function renderCats() {
    const list = $('#catList');
    const visible = $$('.cat-sec').map(s => s.dataset.cat);
    list.innerHTML = menu.categories.filter(c => visible.includes(c.id))
      .map(c => `<button class="cat-chip" role="tab" data-go="${c.id}">${esc(c.name)}</button>`).join('');
    spy();
  }

  $('#catList').addEventListener('click', e => {
    const b = e.target.closest('[data-go]'); if (!b) return;
    $('#cat-' + b.dataset.go)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function spy() {
    const secs = $$('.cat-sec'); let cur = secs[0]?.dataset.cat;
    secs.forEach(s => { if (s.getBoundingClientRect().top < 180) cur = s.dataset.cat; });
    $$('.cat-chip').forEach(c => {
      const on = c.dataset.go === cur;
      c.classList.toggle('is-active', on); c.setAttribute('aria-selected', on);
      if (on) {
        const list = c.parentElement, l = c.offsetLeft, r = l + c.offsetWidth;
        if (l < list.scrollLeft || r > list.scrollLeft + list.clientWidth) list.scrollTo({ left: l - 16, behavior: 'smooth' });
      }
    });
  }
  let spyRaf; window.addEventListener('scroll', () => { cancelAnimationFrame(spyRaf); spyRaf = requestAnimationFrame(spy); }, { passive: true });

  $('#search').addEventListener('input', e => { query = e.target.value; renderMenu(); });

  /* Clique nos cards */
  $('#cardapio').addEventListener('click', e => {
    const add = e.target.closest('[data-add]'); if (add) return openAdd(add.dataset.add);
  });

  /* ---------- Modal Adicionar ---------- */
  let addCtx = null;
  function openAdd(id) {
    const { item } = findItem(id);
    addCtx = { id, qty: 1 };
    $('#addTitle').textContent = item.name;
    $('#addDesc').textContent = item.desc || '';
    $('#addDesc').hidden = !item.desc;
    $('#addNote').value = '';
    $('#addQty').textContent = '1';
    const box = $('#addVariants');
    if (item.variants.length > 1) {
      box.innerHTML = item.variants.map((v, k) => `<label class="variant">
        <span><input type="radio" name="variant" value="${k}" ${k === 0 ? 'checked' : ''}>${esc(v.label || 'Padrão')}</span>
        <strong>${v.price != null ? money(v.price) : 'A consultar'}</strong></label>`).join('');
    } else {
      const v = item.variants[0];
      box.innerHTML = `<div class="variant"><span>Preço</span><strong>${v.price != null ? money(v.price) : 'Valor a consultar'}</strong></div>`;
    }
    openModal('addModal');
  }
  $('#addMinus').onclick = () => { addCtx.qty = Math.max(1, addCtx.qty - 1); $('#addQty').textContent = addCtx.qty; };
  $('#addPlus').onclick = () => { addCtx.qty = Math.min(99, addCtx.qty + 1); $('#addQty').textContent = addCtx.qty; };
  $('#addConfirm').onclick = () => {
    const { item } = findItem(addCtx.id);
    const vi = Number($('input[name=variant]:checked', $('#addVariants'))?.value || 0);
    const v = item.variants[vi];
    const note = $('#addNote').value.trim();
    const key = item.id + '|' + vi + '|' + note;
    const ex = cart.find(c => c.key === key);
    if (ex) ex.qty += addCtx.qty;
    else cart.push({ key, id: item.id, name: item.name, variant: v.label || '', price: v.price, qty: addCtx.qty, note });
    saveCart(); renderCart(); closeModal('addModal');
    toast(`${addCtx.qty}x ${item.name} adicionado`);
  };

  /* =========================================================
     CARRINHO
     ========================================================= */
  const subtotal = () => cart.reduce((s, c) => s + (c.price || 0) * c.qty, 0);
  const hasAsk = () => cart.some(c => c.price == null);
  const isDelivery = () => $('input[name=tipo]:checked').value === 'entrega';
  const fee = () => (cart.length && isDelivery() ? Number(menu.settings.deliveryFee) || 0 : 0);

  function renderCart() {
    const qty = cart.reduce((s, c) => s + c.qty, 0);
    $('#cartCount').textContent = qty;
    $('#cartBarQty').textContent = qty;
    $('#cartBar').hidden = qty === 0;
    $('#cartEmpty').hidden = cart.length > 0;
    $('#cartList').innerHTML = cart.map((c, i) => `<li class="ci">
      <div class="ci__name">${esc(c.name)} ${c.variant ? `<span class="ci__var">· ${esc(c.variant)}</span>` : ''}</div>
      <div class="ci__price">${c.price != null ? money(c.price * c.qty) : 'A consultar'}</div>
      <div class="ci__note"><input data-note="${i}" value="${esc(c.note)}" placeholder="Observação (opcional)" aria-label="Observação do item"></div>
      <div class="ci__row">
        <div class="qty"><button data-dec="${i}" aria-label="Diminuir">−</button><span>${c.qty}</span><button data-inc="${i}" aria-label="Aumentar">+</button></div>
        <button class="ci__rm" data-rm="${i}">Remover</button>
      </div></li>`).join('');
    const sub = subtotal(), f = fee();
    $('#tSub').textContent = money(sub);
    $('#tFee').textContent = f ? money(f) : (isDelivery() ? 'A combinar' : '—');
    $('#tFeeRow').hidden = !isDelivery();
    $('#tTotal').textContent = money(sub + f);
    $('#cartBarTotal').textContent = money(sub + f);
    $('#tNote').hidden = !hasAsk();
    $('#btnNext').disabled = cart.length === 0;
    if (!cart.length && step === 2) goStep(1);
    if (step === 2) updatePreview();
  }

  $('#cartList').addEventListener('click', e => {
    const t = e.target.closest('button'); if (!t) return;
    if (t.dataset.inc) cart[t.dataset.inc].qty = Math.min(99, cart[t.dataset.inc].qty + 1);
    if (t.dataset.dec) { const c = cart[t.dataset.dec]; c.qty--; if (c.qty < 1) cart.splice(t.dataset.dec, 1); }
    if (t.dataset.rm) cart.splice(t.dataset.rm, 1);
    saveCart(); renderCart();
  });
  $('#cartList').addEventListener('change', e => {
    const i = e.target.dataset.note; if (i == null) return;
    cart[i].note = e.target.value.trim(); saveCart();
  });

  /* Drawer */
  function openDrawer() {
    $('#drawer').classList.add('is-open'); $('#drawer').setAttribute('aria-hidden', 'false');
    $('#overlay').hidden = false; document.body.style.overflow = 'hidden';
    setTimeout(() => $('#btnCloseDrawer').focus(), 50);
  }
  function closeDrawer() {
    $('#drawer').classList.remove('is-open'); $('#drawer').setAttribute('aria-hidden', 'true');
    $('#overlay').hidden = true; document.body.style.overflow = '';
  }
  $('#btnCart').onclick = openDrawer;
  $('#cartBar').onclick = openDrawer;
  $('#btnCloseDrawer').onclick = closeDrawer;
  $('#overlay').onclick = closeDrawer;

  function goStep(n) {
    step = n;
    $('#stepCart').hidden = n !== 1;
    $('#stepForm').hidden = n !== 2;
    $('#btnNext').hidden = n !== 1;
    $('#btnSend').hidden = n !== 2;
    $('#btnBack').hidden = n !== 2;
    $('#drawerTitle').textContent = n === 1 ? 'Seu carrinho' : 'Dados de entrega';
    $$('.step').forEach(s => s.classList.toggle('is-active', Number(s.dataset.step) <= n));
    if (n === 2) { updatePreview(); setTimeout(() => $('#fNome').focus(), 50); }
    $('#stepForm').scrollTop = 0;
  }
  $('#btnNext').onclick = () => cart.length && goStep(2);
  $('#btnBack').onclick = () => goStep(1);

  /* =========================================================
     FORMULÁRIO + VALIDAÇÃO
     ========================================================= */
  const form = $('#stepForm');
  const F = n => form.elements[n];

  /* Restaurar dados do cliente salvos */
  const savedCust = store.get(KEY_CUST, null);
  if (savedCust) Object.entries(savedCust).forEach(([k, v]) => { if (F(k) && F(k).type !== 'radio') F(k).value = v; });

  /* Máscaras */
  F('cep').addEventListener('input', e => {
    let d = onlyDigits(e.target.value).slice(0, 8);
    e.target.value = d.length > 5 ? d.slice(0, 5) + '-' + d.slice(5) : d;
    if (d.length === 8) lookupCep(d);
    else { cepState = { ok: false, cep: '', data: null }; setCepStatus('', ''); }
  });
  F('telefone').addEventListener('input', e => {
    let d = onlyDigits(e.target.value).slice(0, 11);
    let out = d;
    if (d.length > 2) out = `(${d.slice(0, 2)}) ` + d.slice(2);
    if (d.length > 7) out = `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}`;
    e.target.value = out;
  });

  function setCepStatus(txt, cls) { const s = $('#cepStatus'); s.textContent = txt; s.className = 'cep-status ' + cls; }

  /* Consulta ViaCEP */
  let cepReq = 0;
  async function lookupCep(cep) {
    const my = ++cepReq;
    setCepStatus('Buscando…', 'loading');
    clearErr(F('cep'));
    try {
      const ctrl = new AbortController(); const to = setTimeout(() => ctrl.abort(), 7000);
      const r = await fetch(`https://viacep.com.br/ws/${cep}/json/`, { signal: ctrl.signal });
      clearTimeout(to);
      if (my !== cepReq) return;
      if (!r.ok) throw new Error('http');
      const d = await r.json();
      if (d.erro) {
        cepState = { ok: false, cep, data: null };
        setCepStatus('Inválido', 'bad');
        return setErr(F('cep'), 'CEP não encontrado. Confira os números.');
      }
      const uf = (menu.settings.restrictUF || '').trim().toUpperCase();
      if (uf && d.uf !== uf) {
        cepState = { ok: false, cep, data: d };
        setCepStatus('Fora da área', 'bad');
        return setErr(F('cep'), `Entregamos apenas em ${uf}. Este CEP é de ${d.localidade}/${d.uf}.`);
      }
      cepState = { ok: true, cep, data: d };
      setCepStatus('✓ Válido', 'ok');
      if (d.logradouro) F('rua').value = d.logradouro;
      if (d.bairro) F('bairro').value = d.bairro;
      F('cidade').value = `${d.localidade}/${d.uf}`;
      ['rua', 'bairro', 'cidade'].forEach(n => F(n).value && clearErr(F(n)));
      markValid(F('cep'));
      (F('rua').value ? F('numero') : F('rua')).focus();
      updatePreview();
    } catch {
      if (my !== cepReq) return;
      /* Sem conexão com o serviço: aceita formato válido e pede preenchimento manual */
      cepState = { ok: true, cep, data: null, offline: true };
      setCepStatus('Preencha manual', 'loading');
      toast('Não foi possível consultar o CEP agora. Preencha o endereço manualmente.');
    }
  }

  function fieldWrap(el) { return el.closest('.field'); }
  function setErr(el, msg) { const w = fieldWrap(el); w.classList.add('is-invalid'); w.classList.remove('is-valid'); w.querySelector('.err').textContent = msg; el.setAttribute('aria-invalid', 'true'); }
  function clearErr(el) { const w = fieldWrap(el); w.classList.remove('is-invalid'); const e = w.querySelector('.err'); if (e) e.textContent = ''; el.removeAttribute('aria-invalid'); }
  function markValid(el) { fieldWrap(el).classList.add('is-valid'); }

  function validateField(el) {
    const v = el.value.trim(); const n = el.name;
    if (n === 'nome') {
      if (!v) return setErr(el, 'Informe seu nome.'), false;
      if (v.length < 3 || !/[A-Za-zÀ-ÿ]{2,}/.test(v)) return setErr(el, 'Digite um nome válido.'), false;
    }
    if (n === 'telefone') {
      const d = onlyDigits(v);
      if (!d) return setErr(el, 'Informe um telefone para contato.'), false;
      if (d.length < 10 || d.length > 11) return setErr(el, 'Telefone deve ter DDD + número (10 ou 11 dígitos).'), false;
    }
    if (isDelivery()) {
      if (n === 'cep') {
        const d = onlyDigits(v);
        if (!d) return setErr(el, 'Informe o CEP.'), false;
        if (d.length !== 8) return setErr(el, 'O CEP deve ter 8 dígitos.'), false;
        if (/^(\d)\1{7}$/.test(d)) return setErr(el, 'CEP inválido.'), false;
        if (cepState.cep === d && !cepState.ok) return false; // erro já exibido pela consulta
      }
      if (n === 'numero' && !v) return setErr(el, 'Informe o número (ou S/N).'), false;
      if (n === 'rua' && v.length < 3) return setErr(el, 'Informe a rua/avenida.'), false;
      if (n === 'bairro' && !v) return setErr(el, 'Informe o bairro.'), false;
      if (n === 'cidade' && !v) return setErr(el, 'Informe a cidade.'), false;
    }
    if (n === 'pagamento' && !v) return setErr(el, 'Escolha a forma de pagamento.'), false;
    if (n === 'troco' && v) {
      const t = parseNum(v);
      if (!Number.isFinite(t)) return setErr(el, 'Valor inválido.'), false;
      if (t < subtotal() + fee()) return setErr(el, `O troco deve ser maior que o total (${money(subtotal() + fee())}).`), false;
    }
    clearErr(el); return true;
  }

  form.addEventListener('focusout', e => { if (e.target.name && fieldWrap(e.target)?.querySelector('.err') && e.target.value) validateField(e.target); });
  form.addEventListener('input', e => { if (fieldWrap(e.target)?.classList.contains('is-invalid') && e.target.name !== 'cep') validateField(e.target); updatePreview(); });
  form.addEventListener('change', e => {
    if (e.target.name === 'tipo') {
      $('#addrBlock').hidden = !isDelivery();
      $('#pickupBlock').hidden = isDelivery();
      renderCart();
    }
    if (e.target.name === 'pagamento') {
      $('#trocoField').hidden = e.target.value !== 'Dinheiro';
      validateField(e.target);
    }
    updatePreview();
  });
  form.addEventListener('submit', e => e.preventDefault());

  function validateAll() {
    let first = null;
    const names = ['nome', 'telefone', ...(isDelivery() ? ['cep', 'numero', 'rua', 'bairro', 'cidade'] : []), 'pagamento'];
    if (F('pagamento').value === 'Dinheiro') names.push('troco');
    names.forEach(n => { if (!validateField(F(n)) && !first) first = F(n); });
    if (first) { first.focus(); first.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
    return !first;
  }

  /* =========================================================
     MENSAGEM + WHATSAPP
     ========================================================= */
  function buildMessage() {
    const now = new Date();
    const dt = now.toLocaleDateString('pt-BR') + ' às ' + now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    const L = [];
    L.push(`*NOVO PEDIDO — ${menu.settings.storeName || "D'Ksa"}*`);
    L.push(`_${dt}_`);
    L.push('');
    L.push('*Cliente*');
    L.push(`Nome: ${F('nome').value.trim() || '—'}`);
    L.push(`Telefone: ${F('telefone').value.trim() || '—'}`);
    L.push('');
    if (isDelivery()) {
      L.push('*Endereço de entrega*');
      L.push(`${F('rua').value.trim() || '—'}, nº ${F('numero').value.trim() || '—'}`);
      if (F('complemento').value.trim()) L.push(`Compl.: ${F('complemento').value.trim()}`);
      L.push(`Bairro: ${F('bairro').value.trim() || '—'}`);
      L.push(`Cidade: ${F('cidade').value.trim() || '—'}`);
      L.push(`CEP: ${F('cep').value.trim() || '—'}`);
    } else {
      L.push('*Retirada no local*');
      if (menu.settings.address) L.push(menu.settings.address);
    }
    L.push('');
    L.push('*Itens do pedido*');
    cart.forEach(c => {
      const nm = c.name + (c.variant ? ` (${c.variant})` : '');
      const pr = c.price != null ? money(c.price * c.qty) : 'a consultar';
      L.push(`• ${c.qty}x ${nm} — ${pr}`);
      if (c.note) L.push(`   _Obs.: ${c.note}_`);
    });
    L.push('');
    L.push(`Subtotal: ${money(subtotal())}`);
    if (isDelivery()) L.push(`Taxa de entrega: ${fee() ? money(fee()) : 'a combinar/grátis'}`);
    L.push(`*TOTAL: ${money(subtotal() + fee())}*`);
    if (hasAsk()) L.push('_(+ itens com valor a consultar)_');
    L.push('');
    L.push(`*Pagamento:* ${F('pagamento').value || '—'}`);
    if (F('pagamento').value === 'Dinheiro') {
      const t = parseNum(F('troco').value);
      L.push(Number.isFinite(t) && t ? `Troco para: ${money(t)} (devolver ${money(t - subtotal() - fee())})` : 'Não precisa de troco');
    }
    if (F('obs').value.trim()) { L.push(''); L.push(`*Observações:* ${F('obs').value.trim()}`); }
    return L.join('\n');
  }
  function updatePreview() { if (step === 2) $('#msgPreview').textContent = buildMessage(); }

  let lastMsg = '';
  $('#btnSend').onclick = () => {
    if (isClosedToday()) return toast('Hoje (segunda-feira) estamos fechados. Envie seu pedido a partir de amanhã.', 'err');
    if (!cart.length) return toast('Seu carrinho está vazio', 'err');
    if (!validateAll()) return toast('Confira os campos destacados', 'err');
    const phone = onlyDigits(menu.settings.whatsapp);
    if (phone.length < 12) return toast('WhatsApp da loja não configurado. Ajuste em Editar cardápio > Configurações.', 'err');

    lastMsg = buildMessage();
    const url = `https://wa.me/${phone}?text=${encodeURIComponent(lastMsg)}`;

    /* Salva dados do cliente para a próxima compra */
    const cust = {}; ['nome', 'telefone', 'cep', 'numero', 'rua', 'bairro', 'cidade', 'complemento'].forEach(n => cust[n] = F(n).value);
    store.set(KEY_CUST, cust);

    $('#waLink').href = url;
    let w = null; try { w = window.open(url, '_blank', 'noopener'); } catch {}
    openModal('doneModal');
    if (!w) toast('Toque em "Abrir WhatsApp" para concluir');
  };
  $('#btnCopyMsg').onclick = async () => {
    try { await navigator.clipboard.writeText(lastMsg); toast('Mensagem copiada'); }
    catch {
      const ta = document.createElement('textarea'); ta.value = lastMsg; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); toast('Mensagem copiada'); } catch { toast('Não foi possível copiar', 'err'); }
      ta.remove();
    }
  };
  $('#btnNewOrder').onclick = () => {
    cart = []; saveCart(); F('obs').value = ''; F('troco').value = '';
    closeModal('doneModal'); goStep(1); renderCart(); closeDrawer();
    toast('Pronto para um novo pedido');
  };

  function isClosedToday() {
    const days = menu.settings.closedDays || [];
    return days.includes(new Date().getDay());
  }
  function applyInfo() {
    const s = menu.settings;
    $$('[data-address]').forEach(el => el.textContent = s.address || '');
    const q = encodeURIComponent(s.mapsQuery || s.address || '');
    $$('[data-maps]').forEach(el => el.href = 'https://www.google.com/maps/search/?api=1&query=' + q);
    const closed = isClosedToday();
    $('#closedBanner').hidden = !closed;
    $('#btnSend').classList.toggle('is-closed', closed);
  }
  function applyBrand() {
    const nm = (menu.settings.storeName || "Sabor D'Ksa").trim();
    const sp = nm.indexOf(' ');
    const html = sp > 0 ? `<span class="b1">${esc(nm.slice(0, sp))}</span> <span class="b2">${esc(nm.slice(sp + 1))}</span>` : `<span class="b2">${esc(nm)}</span>`;
    $$('.brand__name, .hero__title').forEach(el => el.innerHTML = html);
    document.title = `${nm} — Faça seu pedido`;
  }

  /* Remove do carrinho itens que não existem mais no cardápio */
  cart = cart.filter(c => findItem(c.id));

  /* =========================================================
     RESERVA DE MESA
     ========================================================= */
  const reservaBgs = $$('.reserva-bg');
  let reservaBgIdx = 0;
  let reservaBgTimer = null;

  function startReservaBg() {
    if (reservaBgTimer) return;
    reservaBgTimer = setInterval(() => {
      reservaBgs[reservaBgIdx].classList.remove('active');
      reservaBgIdx = (reservaBgIdx + 1) % reservaBgs.length;
      reservaBgs[reservaBgIdx].classList.add('active');
    }, 4500);
  }
  function stopReservaBg() {
    if (reservaBgTimer) { clearInterval(reservaBgTimer); reservaBgTimer = null; }
  }

  $('#btnReserva').onclick = () => {
    // Define data mínima = hoje
    const hoje = new Date();
    const yyyy = hoje.getFullYear();
    const mm = String(hoje.getMonth() + 1).padStart(2, '0');
    const dd = String(hoje.getDate()).padStart(2, '0');
    const resData = $('#resData');
    resData.min = `${yyyy}-${mm}-${dd}`;
    if (!resData.value) resData.value = `${yyyy}-${mm}-${dd}`;
    openModal('reservaModal');
    startReservaBg();
  };

  function buildReservaMsg() {
    const nome = $('#resNome').value.trim();
    const qtd = $('#resQtd').value;
    const data = $('#resData').value;
    const chegada = $('#resChegada').value;
    const servir = $('#resServir').value;
    const local = $('#resLocal').value;
    const pedido = $('#resPedido').value.trim();

    // Formata data pt-BR
    let dataFmt = data;
    if (data) {
      const [y, m, d] = data.split('-');
      dataFmt = `${d}/${m}/${y}`;
    }

    const L = [];
    L.push(`*RESERVA DE MESA — ${menu.settings.storeName || "Sabor D'Ksa"}*`);
    L.push(`_${new Date().toLocaleDateString('pt-BR')} às ${new Date().toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'})}_`);
    L.push('');
    L.push('*Dados da reserva*');
    L.push(`Nome: ${nome || '—'}`);
    L.push(`Quantidade de pessoas: ${qtd || '—'}`);
    L.push(`Data: ${dataFmt || '—'}`);
    L.push(`Horário de chegada: ${chegada || '—'}`);
    if (servir) L.push(`Horário de servir: ${servir}`);
    L.push(`Local da reserva: ${local || '—'}`);
    if (pedido) {
      L.push('');
      L.push('*Pedido / Observações*');
      L.push(pedido);
    }
    L.push('');
    L.push('_Aguardo confirmação da reserva. Obrigado!_');
    return L.join('\n');
  }

  $('#reservaForm').onsubmit = e => {
    e.preventDefault();
    // Validação simples
    let ok = true;
    const nome = $('#resNome').value.trim();
    if (nome.length < 3) { $('#errNome').textContent = 'Informe nome e sobrenome'; ok = false; }
    else $('#errNome').textContent = '';
    if (!$('#resQtd').value || +$('#resQtd').value < 1) { $('#errQtd').textContent = 'Informe a quantidade'; ok = false; }
    else $('#errQtd').textContent = '';
    if (!$('#resData').value) { $('#errData').textContent = 'Escolha a data'; ok = false; }
    else $('#errData').textContent = '';
    if (!$('#resChegada').value) { $('#errChegada').textContent = 'Informe o horário'; ok = false; }
    else $('#errChegada').textContent = '';
    if (!$('#resLocal').value) { $('#errLocal').textContent = 'Selecione o local'; ok = false; }
    else $('#errLocal').textContent = '';

    if (!ok) return toast('Confira os campos destacados', 'err');

    if (isClosedToday()) {
      // Aviso mas ainda permite (reserva pode ser para outro dia)
      // Só bloqueia se a data escolhida for segunda
      const dataSel = new Date($('#resData').value + 'T12:00:00');
      if (dataSel.getDay() === 1) {
        return toast('Nas segundas-feiras estamos fechados. Escolha outro dia.', 'err');
      }
    }

    const phone = onlyDigits(menu.settings.whatsapp);
    if (phone.length < 12) return toast('WhatsApp da loja não configurado.', 'err');

    const msg = buildReservaMsg();
    const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

    // Guarda a mensagem para poder copiar depois
    window._lastReservaMsg = msg;

    // Preenche o link do modal de sucesso
    $('#reservaWaLink').href = url;

    // Tenta abrir o WhatsApp
    let w = null;
    try { w = window.open(url, '_blank', 'noopener'); } catch {}

    // Fecha o formulário e abre o modal de sucesso (sempre)
    closeModal('reservaModal');
    stopReservaBg();
    openModal('reservaDoneModal');

    if (!w) {
      toast('Toque em "Abrir WhatsApp" para concluir', 'err');
    } else {
      toast('Reserva encaminhada! Confirme no WhatsApp.');
    }

    // Limpa apenas o campo de pedido
    $('#resPedido').value = '';
  };

  // Botão de copiar mensagem da reserva
  $('#btnCopyReservaMsg').onclick = async () => {
    const msg = window._lastReservaMsg || '';
    try {
      await navigator.clipboard.writeText(msg);
      toast('Mensagem copiada');
    } catch {
      const ta = document.createElement('textarea');
      ta.value = msg;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); toast('Mensagem copiada'); }
      catch { toast('Não foi possível copiar', 'err'); }
      ta.remove();
    }
  };

  // Fechar o modal de sucesso da reserva
  $('#btnCloseReservaDone').onclick = () => closeModal('reservaDoneModal');

  /* ---------- Início ---------- */
  applyBrand();
  applyInfo();
  renderMenu();
  renderCart();
  $('#trocoField').hidden = F('pagamento').value !== 'Dinheiro';
})();

</script>
</body>
</html>
