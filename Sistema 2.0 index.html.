        variants: [{ label: 'Heineken', price: 14 }, { label: 'Budweiser', price: 14 }, { label: 'Corona', price: 14 }, { label: 'Smirnoff/Skarloff', price: 14 }] },
      { name: 'Energético', desc: 'Red Bull ou Monster.',
